---
// 首页顶部的 X2Post 社区宣传横幅, 整块可点击。
const href = 'https://x2post.com'
---

<a
  class="x2post-hero not-content"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="X2Post 社区 — 立即访问 x2post.com (在新标签页打开)"
>
  <div class="x2post-hero__glow" aria-hidden="true"></div>
  <span class="x2post-hero__watermark" aria-hidden="true">X2</span>

  <div class="x2post-hero__content">
    <div class="x2post-hero__head">
      <span class="x2post-hero__logo-wrap">
        <img
          src="/x2post.svg"
          alt=""
          class="x2post-hero__logo"
          width="72"
          height="72"
          loading="eager"
        />
      </span>

      <div class="x2post-hero__heading">
        <p class="x2post-hero__eyebrow">我的社区 · 欢迎加入</p>
        <h2 class="x2post-hero__title">X2Post 社区</h2>
        <p class="x2post-hero__tagline">认真分享 · 友善讨论</p>
      </div>
    </div>

    <p class="x2post-hero__desc">
      一个认真分享、友善讨论的地方。欢迎来发布你的想法，也欢迎看看大家在聊什么。
    </p>

    <span class="x2post-hero__cta">
      立即访问 x2post.com
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
</a>

<style>
  .x2post-hero {
    position: relative;
    display: block;
    isolation: isolate;
    overflow: hidden;
    margin: 0 0 3rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 1.25rem;
    background: linear-gradient(120deg, #0f766e 0%, #0b6b80 48%, #00769b 100%);
    color: #f0fdfa;
    text-decoration: none;
    box-shadow:
      0 24px 60px -30px rgba(15, 118, 110, 0.85),
      inset 0 1px 0 rgba(255, 255, 255, 0.14);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .x2post-hero:hover {
    transform: translateY(-3px);
    box-shadow:
      0 32px 70px -28px rgba(15, 118, 110, 0.95),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .x2post-hero:focus-visible {
    outline: 3px solid #99f6e4;
    outline-offset: 4px;
  }

  .x2post-hero__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        42rem 22rem at 88% -10%,
        rgba(45, 212, 191, 0.45),
        transparent 70%
      ),
      radial-gradient(
        34rem 20rem at 6% 120%,
        rgba(14, 165, 233, 0.35),
        transparent 70%
      );
  }

  .x2post-hero__watermark {
    position: absolute;
    right: 0.2rem;
    bottom: -0.42em;
    z-index: -1;
    font-size: clamp(10rem, 28vw, 19rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.07em;
    color: rgba(255, 255, 255, 0.09);
    pointer-events: none;
    user-select: none;
  }

  .x2post-hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 40rem;
  }

  .x2post-hero__head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .x2post-hero__logo-wrap {
    flex: none;
    display: grid;
    place-items: center;
    padding: 0.4rem;
    border-radius: 1.15rem;
    background: #ffffff;
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.55);
  }

  .x2post-hero__logo {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.8rem;
  }

  .x2post-hero__heading {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    min-width: 0;
  }

  .x2post-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ccfbf1;
  }

  .x2post-hero__eyebrow::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #2dd4bf;
    box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.25);
  }

  .x2post-hero__title {
    margin: 0;
    font-size: clamp(1.8rem, 4.2vw, 2.6rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .x2post-hero__tagline {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 600;
    color: #ccfbf1;
  }

  .x2post-hero__desc {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    line-height: 1.75;
    color: rgba(240, 253, 250, 0.92);
  }

  .x2post-hero__cta {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.55rem;
    margin-top: 0.4rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    background: #ffffff;
    color: #0f5964;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.6);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background-color 0.25s ease;
  }

  .x2post-hero:hover .x2post-hero__cta {
    transform: translateX(3px);
    background: #f0fdfa;
    box-shadow: 0 18px 34px -14px rgba(0, 0, 0, 0.7);
  }

  @media (max-width: 640px) {
    .x2post-hero {
      margin-bottom: 2rem;
      border-radius: 1rem;
    }

    .x2post-hero__head {
      align-items: flex-start;
      gap: 0.85rem;
    }

    .x2post-hero__logo {
      width: 2.9rem;
      height: 2.9rem;
    }

    .x2post-hero__cta {
      align-self: stretch;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .x2post-hero,
    .x2post-hero__cta {
      transition: none;
    }

    .x2post-hero:hover {
      transform: none;
    }

    .x2post-hero:hover .x2post-hero__cta {
      transform: none;
    }
  }
</style>
