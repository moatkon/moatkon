        <mxCell id="5TSEPTYngGQf3uhzpDhP-22" value="docker启动时配置按照traefik约定配置labels。&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;traefik的依据，和nginx的配置文件一样，这里只是通过docker的labels来实现类似功能。具体见下面的启动指令&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;align=left;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="760" y="310" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="5TSEPTYngGQf3uhzpDhP-23" value="不一定要用宿主机ip,只要网络能访问到就行" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=15;fontSize=14;align=left;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="480" y="130" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="5TSEPTYngGQf3uhzpDhP-27" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;遇到的问题:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;一开始使用的是http://localhost:8081,通过hi.moatkon.com访问总是显示502。localhost是tunnel docker内的网络，当然访问不通&lt;/font&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=18;fontSize=14;align=left;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="480" y="20" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="5TSEPTYngGQf3uhzpDhP-28" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp;traefik代理的是docker服务的原生端口(例如8000)，不是暴露出来端口。因为都用docker了，网络都是通的，就没必要用暴露出来的端口了&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;dashed=1;arcSize=24;verticalAlign=top;fontSize=14;align=left;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="280" y="440" width="470" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
